# Copy to .env.local and fill in (never commit .env.local).

# --- Supabase (required for booking + admin gallery + rate limits) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_KEY=your_service_role_secret

# --- Admin dashboard (httpOnly cookie sessions) ---
ADMIN_PASSWORD=choose_a_strong_password
ADMIN_SESSION_SECRET=min_32_characters_random_string________________

# --- Optional: homepage Experience section embed (must be https://, e.g. YouTube embed URL) ---
# NEXT_PUBLIC_EXPERIENCE_VIDEO_EMBED_URL=https://www.youtube.com/embed/VIDEO_ID?rel=0&modestbranding=1

# --- Optional: rate limits (Supabase RPC jer_check_rate_limit; defaults shown) ---
# BOOKING_RATE_LIMIT_MAX=15
# BOOKING_RATE_LIMIT_WINDOW_SEC=900
# ADMIN_LOGIN_RATE_LIMIT_MAX=10
# ADMIN_LOGIN_RATE_LIMIT_WINDOW_SEC=600
